{
  "name": "botdiscordmyges",
  "version": "3.4.0",
  "description": "Bot Discord MyGes (agenda, notes, projets) — multi-serveurs",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node index.js",
    "start:prod": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch & node --watch dist/index.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
