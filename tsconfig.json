{
  "compilerOptions": {
    "target": "ES2023",
    // Sortie CommonJS (pas de "type": "module" dans package.json) avec la
    // résolution moderne de Node. `node10` a été retiré de TypeScript 7.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "removeComments": false,
    // Interdit la syntaxe TS non effaçable (enum, namespace, parameter properties…).
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
